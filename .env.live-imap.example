# Live IMAP tests are destructive and must use a disposable fixture mailbox.
# Copy this file to .env.live-imap, populate it locally, and never commit that copy.

# Explicit execution opt-in. Change to 1 only after all fixture values are ready.
OSTICKET_MAIL_IMAP_INTEGRATION=0

# IMAP connection.
OSTICKET_MAIL_IMAP_HOST=imap.example.com
OSTICKET_MAIL_IMAP_PORT=993
OSTICKET_MAIL_IMAP_ENCRYPTION=ssl
OSTICKET_MAIL_IMAP_VALIDATE_CERT=true
OSTICKET_MAIL_IMAP_TIMEOUT=30
OSTICKET_MAIL_IMAP_USERNAME=fixture@example.com
OSTICKET_MAIL_IMAP_PASSWORD=

# Source mailbox used by fetch, exact UID lookup, mark-read, move, and delete tests.
OSTICKET_MAIL_IMAP_MAILBOX=INBOX

# Use three distinct source-mailbox UIDs. These tests intentionally mutate them.
OSTICKET_MAIL_IMAP_MARK_READ_UID=
OSTICKET_MAIL_IMAP_MOVE_UID=
OSTICKET_MAIL_IMAP_MOVE_MAILBOX=Processed
OSTICKET_MAIL_IMAP_DELETE_UID=

# Dedicated disposable mailboxes used to verify idempotent readiness provisioning.
# The integration suite may create these folders when they do not already exist.
OSTICKET_MAIL_IMAP_READINESS_MAILBOX=Readiness
OSTICKET_MAIL_IMAP_READINESS_MOVE_MAILBOX=Processed

# Optional readiness regression fixture: an existing mailbox referenced with casing
# that the provider treats as equivalent (for example Processed when the server lists PROCESSED).
# OSTICKET_MAIL_IMAP_CASE_VARIANT_MAILBOX=Processed